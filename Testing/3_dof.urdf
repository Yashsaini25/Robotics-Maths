<?xml version="1.0"?>
<robot name="three_dof_arm">

  <!-- ============ BASE LINK (fixed, doesn't move) ============ -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder radius="0.02" length="0.05"/>
      </geometry>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.02" length="0.05"/>
      </geometry>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- ============ LINK 1: the 10cm horizontal offset piece ============ -->
  <link name="link1">
    <visual>
      <geometry>
        <cylinder radius="0.008" length="0.10"/>
      </geometry>
      <origin xyz="0.05 0 0" rpy="0 1.5708 0"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.008" length="0.10"/>
      </geometry>
      <origin xyz="0.05 0 0" rpy="0 1.5708 0"/>
    </collision>
    <inertial>
      <mass value="0.03"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <!-- Base joint: revolute about vertical z, sits at top of base column -->
  <joint name="base_joint" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="3.14159" effort="10" velocity="1.0"/>
  </joint>

  <!-- ============ LINK 2: upper arm (8cm) ============ -->
  <link name="link2">
    <visual>
      <geometry>
        <cylinder radius="0.008" length="0.08"/>
      </geometry>
      <origin xyz="0.04 0 0" rpy="0 1.5708 0"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.008" length="0.08"/>
      </geometry>
      <origin xyz="0.04 0 0" rpy="0 1.5708 0"/>
    </collision>
    <inertial>
      <mass value="0.03"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <!-- Shoulder joint: revolute, axis perpendicular to base's axis (the alpha=90 twist) -->
  <joint name="shoulder_joint" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.10 0 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="3.14159" effort="10" velocity="1.0"/>
  </joint>

  <!-- ============ LINK 3: forearm (6cm) ============ -->
  <link name="link3">
    <visual>
      <geometry>
        <cylinder radius="0.008" length="0.06"/>
      </geometry>
      <origin xyz="0.03 0 0" rpy="0 1.5708 0"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.008" length="0.06"/>
      </geometry>
      <origin xyz="0.03 0 0" rpy="0 1.5708 0"/>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00003"/>
    </inertial>
  </link>

  <!-- Elbow joint: revolute, parallel to shoulder's axis (alpha=0) -->
  <joint name="elbow_joint" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.08 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="3.14159" effort="10" velocity="1.0"/>
  </joint>

  <!-- ============ GRIPPER (fixed for now -- not a DOF in your IK) ============ -->
  <link name="gripper">
    <visual>
      <geometry>
        <box size="0.02 0.03 0.02"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.03 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="gripper_mount" type="fixed">
    <parent link="link3"/>
    <child link="gripper"/>
    <origin xyz="0.06 0 0" rpy="0 0 0"/>
  </joint>

</robot>